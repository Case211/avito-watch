# Токен бота от @BotFather
BOT_TOKEN=
# Кому можно пользоваться ботом — Telegram ID через запятую; остальным бот отказывает
ADMIN_IDS=

# Часовой пояс: тихие часы, ночь и время в сообщениях
# TZ=Europe/Moscow
# Где искать на Авито, когда вместо ссылки написали просто текст: город из адреса avito.ru/<город> и он же для
# людей («в Москве»)
# AVITO_CITY=moskva
# AVITO_CITY_NAME=Москве
# Минуты между проверками поиска — случайно в этих пределах. Авито режет частые заходы с одного адреса
# AVITO_MINUTES=40-60
# WB_MINUTES=15-25
# Уведомления без звука в эти часы; пусто — всегда со звуком
# QUIET_HOURS=23-8
# Ночью проверок нет (кроме «Проверить сейчас»); пусто — проверять круглые сутки
# NIGHT_HOURS=1-7

# Встроенная видеокарта для WebGL — без него WB не пускает. Номера групп: getent group render video
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# RENDER_GID=991
# VIDEO_GID=44

# Прокси только для Telegram, если он недоступен напрямую: socks5://… или http://…
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# ИИ, по желанию: ключ API Anthropic (console.anthropic.com → API Keys); пусто — бот без ИИ
ANTHROPIC_API_KEY=
# Прокси только для Anthropic, если он недоступен напрямую
# AI_PROXY=http://127.0.0.1:8080
# Модели: вердикт к каждому объявлению и разбор по кнопке «Спросить ИИ»
# AI_VERDICT_MODEL=haiku
# AI_ASK_MODEL=sonnet
